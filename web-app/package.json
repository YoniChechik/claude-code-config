{
  "name": "ccweb",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:test": "next build && mv .next .next-test",
    "start": "next start -p 6379",
    "start:test": "next start -p 6380",
    "prod": "./scripts/build-and-start-prod.sh",
    "stop-prod": "./scripts/stop-prod.sh",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "./scripts/test-e2e-with-build.sh",
    "test:e2e:no-build": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:prod": "./scripts/test-production-pane.sh",
    "test:all": "npm test && ./scripts/test-e2e-with-build.sh",
    "setup-hooks": "cp scripts/pre-push ../.git/hooks/pre-push && chmod +x ../.git/hooks/pre-push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "next": "^16.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.0.0-alpha.25",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4.0.0-alpha.25",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
