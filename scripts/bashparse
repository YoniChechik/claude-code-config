#!/usr/bin/env bash

source "${BASH_SOURCE[0]%/*}/_bashparse.sh"

cwd=$PWD
while (($#)); do
    case $1 in
        --cwd) cwd=$2; shift 2 ;;
        --depth) BP_MAX_DEPTH=$2; shift 2 ;;
        *) printf 'usage: bashparse [--cwd DIR] [--depth N] < command\n' >&2; exit 64 ;;
    esac
done

cmd=$(</dev/stdin)
bp_parse "$cmd" "$cwd"
rc=$?
if ((rc != 0)); then
    printf 'bashparse: %s\n' "$BP_ERR" >&2
    exit "$rc"
fi
printf '%s\n' "$BP_JSON"
