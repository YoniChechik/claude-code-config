#!/bin/bash

# cc - Claude Code wrapper with config checks
# Runs branch status check before starting Claude

CLAUDE_DIR="$HOME/.claude"
ORIG_DIR="$(pwd)"

# Check if .claude directory exists and is a git repository
if [ ! -d "$CLAUDE_DIR" ]; then
    echo "Error: Claude config directory does not exist at $CLAUDE_DIR"
    echo "Expected a git repository with Claude configuration."
    exit 1
fi

cd "$CLAUDE_DIR" || {
    echo "Error: Cannot access Claude config directory at $CLAUDE_DIR"
    exit 1
}

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not a git repository at $CLAUDE_DIR"
    echo "Initialize with: cd ~/.claude && git init"
    exit 1
fi

# Fetch origin/main
if ! git fetch origin main >/dev/null 2>&1; then
    echo "Error: Failed to fetch origin/main"
    echo "Check your network connection and git remote configuration."
    exit 1
fi

# Get current branch
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null)

# Check if we're on a branch (not detached HEAD)
if [ -z "$CURRENT_BRANCH" ]; then
    echo "Error: Detached HEAD state detected. You must be on a branch."
    echo "Switch with: cd ~/.claude && git checkout main"
    exit 1
fi

# Check if we are strictly >= origin/main (equal or ahead)
if ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
    # origin/main is not an ancestor of HEAD - we're either behind or diverged

    if git merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
        # HEAD is ancestor of origin/main - we're behind
        BEHIND_COUNT=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "unknown")
        echo "Error: Branch $CURRENT_BRANCH is BEHIND origin/main by $BEHIND_COUNT commit(s)"
        echo "Run:"
        echo "(cd ~/.claude && git pull)"
        exit 1
    else
        # Neither is ancestor of the other - we've diverged
        echo "Error: Branch $CURRENT_BRANCH has DIVERGED from origin/main"
        echo "Both local and remote have different commits."
        echo "Run:"
        echo "(cd ~/.claude && git pull)"
        exit 1
    fi
fi

# Check if jq is installed
if ! command -v jq >/dev/null 2>&1; then
    echo "Error: jq is not installed"
    echo "Installing jq..."
    if sudo apt-get install -y jq >/dev/null 2>&1; then
        echo "✓ jq installed successfully"
    else
        echo "Error: Failed to install jq"
        echo "Please install manually: sudo apt-get install jq"
        exit 1
    fi
fi

# All checks passed
if [ "$CC_TEST" = "1" ]; then
    echo "✓ All checks passed successfully"
    echo "  - Claude config directory exists"
    echo "  - Git repository is valid"
    echo "  - Successfully fetched origin/main"
    echo "  - On branch: $CURRENT_BRANCH"
    echo "  - Branch is up-to-date with origin/main"
    exit 0
fi

# Return to original directory before starting REPL
cd "$ORIG_DIR" || {
    echo "Error: Cannot return to original directory"
    exit 1
}

# Session management
SESSION_FILE="$HOME/.claude/cc_session_id"
APPEND_SYSTEM_PROMPT="$HOME/.claude/main_appended_system_prompt.md"

# Variable to track current claude process
CLAUDE_PID=""

# Cleanup function
cleanup() {
    if [ -n "$CLAUDE_PID" ]; then
        kill "$CLAUDE_PID" 2>/dev/null
        wait "$CLAUDE_PID" 2>/dev/null
    fi
    exit 0
}

# Trap Ctrl+C for clean exit
trap cleanup SIGINT SIGTERM

# Function to run claude with a prompt
run_claude() {
    local prompt="$1"
    local resume_arg="$2"
    local temp_output=$(mktemp)
    local raw_output=$(mktemp)

    # Run claude and capture raw JSON output
    claude -p "$prompt" \
        --output-format stream-json \
        --include-partial-messages \
        --verbose \
        --append-system-prompt "$(cat "$APPEND_SYSTEM_PROMPT")" \
        $resume_arg 2>&1 | tee "$raw_output" | \
        jq -r --unbuffered 'if .type == "content_block_delta" and .delta.type == "text_delta" then .delta.text else empty end' 2>/dev/null | tee "$temp_output" &

    CLAUDE_PID=$!

    # Monitor for ESC key while claude is running
    (
        while kill -0 "$CLAUDE_PID" 2>/dev/null; do
            read -rsn1 -t 0.1 key
            if [ "$key" = $'\e' ]; then
                kill "$CLAUDE_PID" 2>/dev/null
                echo -e "\n[Interrupted]"
                break
            fi
        done
    ) &
    local monitor_pid=$!

    # Wait for claude to finish
    wait "$CLAUDE_PID" 2>/dev/null
    local exit_code=$?

    # Kill the monitor process
    kill "$monitor_pid" 2>/dev/null
    wait "$monitor_pid" 2>/dev/null

    # Extract session_id from the first JSON line if this is a new session
    if [ ! -f "$SESSION_FILE" ] && [ -s "$raw_output" ]; then
        local session_id=$(head -1 "$raw_output" | jq -r '.session_id // empty' 2>/dev/null)
        if [ -n "$session_id" ]; then
            echo "$session_id" > "$SESSION_FILE"
        fi
    fi

    # Cleanup temp files
    rm -f "$temp_output" "$raw_output"

    CLAUDE_PID=""
    return $exit_code
}

# REPL loop
while true; do
    # Prompt for input
    echo -n "> "
    read -r user_input

    # Check if user wants to quit
    if [ -z "$user_input" ] || [ "$user_input" = "exit" ] || [ "$user_input" = "quit" ]; then
        echo "Exiting..."
        break
    fi

    # Determine if we're resuming a session
    if [ -f "$SESSION_FILE" ]; then
        SESSION_ID=$(cat "$SESSION_FILE")
        RESUME_ARG="--resume $SESSION_ID"
    else
        RESUME_ARG=""
    fi

    # Run claude
    run_claude "$user_input" "$RESUME_ARG"

    echo ""
done

cleanup
