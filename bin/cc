#!/bin/bash

# cc - Claude Code wrapper with config checks and REPL

CLAUDE_DIR="$HOME/.claude"
ORIG_DIR="$(pwd)"

# ============================================================
# GIT CHECKS
# ============================================================
if [ ! -d "$CLAUDE_DIR" ]; then
    echo "Error: Claude config directory does not exist at $CLAUDE_DIR"
    exit 1
fi

cd "$CLAUDE_DIR" || exit 1

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "Error: Not a git repository at $CLAUDE_DIR"
    exit 1
fi

if ! git fetch origin main >/dev/null 2>&1; then
    echo "Error: Failed to fetch origin/main"
    exit 1
fi

CURRENT_BRANCH=$(git branch --show-current 2>/dev/null)
[ -z "$CURRENT_BRANCH" ] && echo "Error: Detached HEAD state" && exit 1

if ! git merge-base --is-ancestor origin/main HEAD 2>/dev/null; then
    echo "Error: Branch $CURRENT_BRANCH is behind or diverged from origin/main"
    echo "Run: (cd ~/.claude && git pull)"
    exit 1
fi

command -v jq >/dev/null 2>&1 || { echo "Error: jq not installed"; exit 1; }

# Test mode
if [ "$CC_TEST" = "1" ]; then
    echo "✓ All checks passed (branch: $CURRENT_BRANCH)"
    exit 0
fi

cd "$ORIG_DIR" || exit 1

# ============================================================
# STATE
# ============================================================
SESSION_ID=""
TOTAL_COST=0
TOTAL_IN=0
TOTAL_OUT=0
LAST_MS=0

# ============================================================
# RUN CLAUDE
# ============================================================
run_claude() {
    local raw=$(mktemp)
    local args=(-p "$1" --output-format stream-json --verbose)
    [ -n "$SESSION_ID" ] && args+=(--resume "$SESSION_ID")
    [ -f "$CLAUDE_DIR/main_appended_system_prompt.md" ] && \
        args+=(--append-system-prompt "$(cat "$CLAUDE_DIR/main_appended_system_prompt.md")")

    # Ctrl+C during run just stops claude, doesn't exit REPL
    trap 'echo -e "\n\033[90m[Stopped]\033[0m"' INT
    claude "${args[@]}" 2>&1 | tee "$raw" | \
        jq -r --unbuffered -f "$CLAUDE_DIR/bin/cc_filter.jq" 2>/dev/null | \
        while IFS= read -r line; do
            case "$line" in
                TEXT:*) printf "%s" "${line#TEXT:}" | sed 's/@@NEWLINE@@/\n/g' ;;
                SUB:*)  printf "\033[90m│\033[0m  %s\n" "${line#SUB:}" ;;
                LINE:*) printf "%s\n" "${line#LINE:}" ;;
            esac
        done
    trap - INT

    # Extract session and stats
    if [ -z "$SESSION_ID" ]; then
        SESSION_ID=$(head -1 "$raw" | jq -r '.session_id // empty' 2>/dev/null)
    fi
    local result=$(grep '"type":"result"' "$raw" | tail -1)
    if [ -n "$result" ]; then
        local cost=$(echo "$result" | jq -r '.total_cost_usd // 0')
        local in=$(echo "$result" | jq -r '.usage.input_tokens // 0')
        local out=$(echo "$result" | jq -r '.usage.output_tokens // 0')
        local cache=$(echo "$result" | jq -r '.usage.cache_read_input_tokens // 0')
        LAST_MS=$(echo "$result" | jq -r '.duration_ms // 0')
        TOTAL_COST=$(awk "BEGIN {print $TOTAL_COST + $cost}")
        TOTAL_IN=$((TOTAL_IN + in + cache))
        TOTAL_OUT=$((TOTAL_OUT + out))
    fi
    rm -f "$raw"
}

# ============================================================
# PROMPT
# ============================================================
show_prompt() {
    printf "\033[90m%s@%s:%s" "$USER" "$(hostname -s)" "$(pwd)"
    if [ "$TOTAL_IN" -gt 0 ]; then
        local sec=$(awk "BEGIN {printf \"%.1f\", $LAST_MS/1000}")
        local in=$TOTAL_IN; [ "$in" -ge 1000 ] && in=$(awk "BEGIN {printf \"%.1fK\", $TOTAL_IN/1000}")
        local out=$TOTAL_OUT; [ "$out" -ge 1000 ] && out=$(awk "BEGIN {printf \"%.1fK\", $TOTAL_OUT/1000}")
        local cost=$(awk "BEGIN {printf \"%.4f\", $TOTAL_COST}")
        printf " [%ss │ ↓%s ↑%s │ \$%s]" "$sec" "$in" "$out" "$cost"
    fi
    printf "\033[0m\n"
}

# ============================================================
# MAIN
# ============================================================
echo "cc - Claude Code REPL (Ctrl+C to stop, Ctrl+D to exit)"
echo ""

while true; do
    show_prompt
    read -r -e -p "> " input || break
    [ -z "$input" ] && continue
    [[ "$input" =~ ^(exit|quit)$ ]] && break
    history -s "$input"
    run_claude "$input"
done
