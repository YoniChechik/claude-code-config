{
  "$schema" : "https:\/\/www.schemastore.org\/claude-code-settings.json",
  "agentPushNotifEnabled" : true,
  "askUserQuestionTimeout" : "10m",
  "autoMode" : {
    "environment" : [
      "$defaults",
      "Trusted internal domains: activate.sunsay.com, activate-staging.sunsay.com (Sunsay's own subscription-activation subdomains, backed by website's Next.js app), mail.google.com (Yoni's own Gmail, used to read order-confirmation\/activation emails during Shopify subscription E2E testing)"
    ]
  },
  "disableBypassPermissionsMode" : false,
  "effortLevel" : "high",
  "env" : {
    "API_TIMEOUT_MS" : "600000",
    "CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS" : "300000",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE" : "1",
    "CLAUDE_STREAM_FIRST_BYTE_TIMEOUT_MS" : "600000",
    "ENABLE_TOOL_SEARCH" : "true"
  },
  "feedbackDrafts" : "off",
  "hooks" : {
    "Elicitation" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "ElicitationResult" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "Notification" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "PermissionRequest" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/permission_request.sh",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "PostToolUse" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "bash $HOME\/.claude\/scripts\/post_tool_use__ruff.sh",
            "timeout" : 30,
            "type" : "command"
          }
        ],
        "matcher" : "Edit|Write"
      },
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "bash $HOME\/.claude\/scripts\/post_tool_use__eslint.sh",
            "timeout" : 30,
            "type" : "command"
          }
        ],
        "matcher" : "Edit|Write"
      },
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "bash $HOME\/.claude\/scripts\/post_tool_use__md_tables.sh",
            "timeout" : 30,
            "type" : "command"
          }
        ],
        "matcher" : "Edit|Write"
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/post_tool_use__gh_monitor_trigger.sh",
            "suppressOutput" : true,
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      },
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "bash $HOME\/.claude\/scripts\/post_tool_use__sync_main_after_merge.sh",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      }
    ],
    "PreToolUse" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/pre_tool_use__block_plan_mode.sh",
            "type" : "command"
          }
        ],
        "matcher" : "EnterPlanMode|ExitPlanMode"
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/pre_tool_use__dispatch.sh",
            "type" : "command"
          }
        ],
        "matcher" : "Bash|Edit|Write|NotebookEdit"
      },
      {
        "hooks" : [
          {
            "command" : "rtk hook claude",
            "type" : "command"
          }
        ],
        "matcher" : "Bash"
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ],
        "matcher" : "AskUserQuestion"
      }
    ],
    "PostToolUseFailure" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionEnd" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "SessionStart" : [
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "bash $HOME\/.claude\/scripts\/session_start.sh",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/session_start_main_agent_prompt.sh",
            "type" : "command"
          }
        ],
        "matcher" : "*"
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ],
        "matcher" : "startup|resume|clear"
      }
    ],
    "Stop" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/stop__session_name_reminder.sh",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "async" : true,
            "command" : "bash $HOME\/.claude\/scripts\/stop__wakeup_status.sh",
            "type" : "command"
          }
        ]
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "StopFailure" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/stop_failure__rate_limit.sh",
            "type" : "command"
          }
        ],
        "matcher" : "rate_limit"
      },
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "SubagentStop" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ],
    "UserPromptSubmit" : [
      {
        "hooks" : [
          {
            "command" : "bash $HOME\/.claude\/scripts\/tab_color.sh",
            "type" : "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy" : false,
  "includeGitInstructions" : false,
  "inputNeededNotifEnabled" : true,
  "model" : "sonnet",
  "permissions" : {
    "defaultMode" : "bypassPermissions"
  },
  "preferredNotifChannel" : "notifications_disabled",
  "remoteControlAtStartup" : true,
  "showThinkingSummaries" : true,
  "skipDangerousModePermissionPrompt" : true,
  "statusLine" : {
    "command" : "bash ~\/.claude\/scripts\/status_line.sh",
    "refreshInterval" : 1,
    "type" : "command"
  },
  "tui" : "fullscreen",
  "voice" : {
    "enabled" : true,
    "mode" : "hold"
  },
  "voiceEnabled" : true
}