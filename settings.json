{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo unarchive:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo autolink create:*)",
      "Bash(gh repo autolink delete:*)",
      "Bash(gh repo deploy-key add:*)",
      "Bash(gh repo deploy-key delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr revert:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh gist delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh run delete:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)",
      "Bash(gh variable set:*)",
      "Bash(gh variable delete:*)",
      "Bash(gh ssh-key add:*)",
      "Bash(gh ssh-key delete:*)",
      "Bash(gh gpg-key add:*)",
      "Bash(gh gpg-key delete:*)",
      "Bash(gh codespace delete:*)",
      "Bash(gh cache delete:*)",
      "Bash(gh extension remove:*)",
      "Bash(gh label delete:*)",
      "Bash(gh project delete:*)",
      "Bash(gh project item-delete:*)",
      "Bash(gh project item-archive:*)",
      "Bash(gh project field-delete:*)",
      "Bash(gh project mark-template:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh alias delete:*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/cleanup_untracked_clones.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo -e '\\a'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo -e '\\a'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.claude/scripts/post_edit_ruff.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name'); dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); usage=$(echo \"$input\" | jq '.context_window.current_usage'); if [ \"$usage\" != \"null\" ]; then current=$(echo \"$usage\" | jq '.input_tokens + .cache_creation_input_tokens + .cache_read_input_tokens'); size=$(echo \"$input\" | jq '.context_window.context_window_size'); pct=$((current * 100 / size)); printf '%s in %s | %d%% context' \"$model\" \"$dir\" \"$pct\"; else printf '%s in %s' \"$model\" \"$dir\"; fi"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  }
}
